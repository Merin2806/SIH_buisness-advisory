# Database Configuration
# Default local SQLite fallback: sqlite:///./ruralbiz.db
# PostgreSQL with PostGIS & pgvector: postgresql://postgres:postgres@localhost:5432/ruralbiz
DATABASE_URL=sqlite:///./ruralbiz.db

# Security & Authentication
# Generate a secure 32+ byte string using: openssl rand -hex 32
SECRET_KEY=super-secret-ruralbiz-sih-26091-jwt-encryption-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Administrator Bootstrap Credentials (Pre-configured for Hackathon Evaluation)
ADMIN_NAME=Riya
ADMIN_EMAIL=riyamokale@gmail.com
ADMIN_PHONE=9326577285
ADMIN_INITIAL_PASSWORD=AdminRuralBiz@2026

# AI LLM Provider Configuration
# Obtain from: https://console.groq.com/keys (Free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Alternative AI Provider (Together AI)
# Obtain from: https://api.together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3-8B-Instruct-Lite

# Embeddings & Semantic Retrieval
EMBEDDING_MODEL=BAAI/bge-m3

# Geospatial & OpenStreetMap Telemetry
OVERPASS_URL=https://overpass-api.de/api/interpreter
