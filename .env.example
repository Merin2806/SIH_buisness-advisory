# Bhashini Indic Voice & Translation API
# Obtain from: https://bhashini.gov.in/ulca/user/login
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_PIPELINE_ID=

# Network URLs & CORS
